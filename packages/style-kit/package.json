{
  "name": "js-style-kit",
  "version": "0.8.12",
  "description": "A zero configuration style guide for oxlint and oxfmt",
  "keywords": [
    "oxlint",
    "oxfmt",
    "oxc",
    "style guide"
  ],
  "homepage": "https://github.com/drake-nathan/js-style-kit#readme",
  "bugs": {
    "url": "https://github.com/drake-nathan/js-style-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drake-nathan/js-style-kit.git"
  },
  "license": "MIT",
  "author": "Nathan Drake <nathan@drakewest.dev>",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/bin/index.cjs",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "test": "bun test src bin",
    "test:coverage": "bun test src bin --coverage --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@convex-dev/eslint-plugin": ">=1.0.0",
    "@tanstack/eslint-plugin-query": ">=5.0.0",
    "eslint-plugin-perfectionist": ">=4.0.0",
    "eslint-plugin-prefer-arrow-functions": ">=3.0.0",
    "eslint-plugin-react-hooks": ">=7.0.0",
    "eslint-plugin-storybook": ">=0.10.0",
    "eslint-plugin-turbo": ">=2.0.0",
    "oxfmt": ">=0.51.0",
    "oxlint": ">=1.66.0",
    "oxlint-tailwindcss": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@convex-dev/eslint-plugin": {
      "optional": true
    },
    "@tanstack/eslint-plugin-query": {
      "optional": true
    },
    "eslint-plugin-perfectionist": {
      "optional": true
    },
    "eslint-plugin-prefer-arrow-functions": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-storybook": {
      "optional": true
    },
    "eslint-plugin-turbo": {
      "optional": true
    },
    "oxlint-tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "1.3.8",
    "@types/node": "24.10.1",
    "commander": "14.0.3",
    "glob": "13.0.0",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.11.0 || >=21.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
