519"},{"kind":"504","justification":"360"},[21,154],{"kind":"504","justification":"360"},[21,157],"/**\n * Generated data model types.\n *\n * THIS CODE IS AUTOMATICALLY GENERATED.\n *\n * To regenerate, run `npx convex dev`.\n *\n * @module\n */",{"kind":"504","justification":"360"},[226,267],"SystemTableNames,\n  TableNamesInDataModel",{"kind":"504","justification":"360"},[347,347]," type",{"kind":"504","justification":"360"},[340,341],"\n\n",{"kind":"504","justification":"360"},[488,624],"/**\n * The type of a document stored in Convex.\n *\n * @template TableName - A string literal type of the table name (like \"users\").\n */",{"kind":"504","justification":"360"},[718,1246],"/**\n * An identifier for a document in Convex.\n *\n * Convex documents are uniquely identified by their `Id`, which is accessible\n * on the `_id` field. To learn more, see [Document IDs](https://docs.convex.dev/using/document-ids).\n *\n * Documents can be loaded using `db.get(id)` in query and mutation functions.\n *\n * IDs are just strings at runtime, but this type can be used to distinguish them from other\n * strings when type checking.\n *\n * @template TableName - A string literal type of the table name (like \"users\").\n */",{"kind":"504","justification":"360"},[1280,1309],"SystemTableNames | TableNames",{"kind":"504","justification":"360"},[21,215],"/**\n * Generated utilities for implementing server-side Convex query and mutation functions.\n *\n * THIS CODE IS AUTOMATICALLY GENERATED.\n *\n * To regenerate, run `npx convex dev`.\n *\n * @module\n */",{"kind":"504","justification":"360"},[228,425],"type ActionBuilder,\n  AnyComponents,\n  type HttpActionBuilder,\n  type MutationBuilder,\n  type QueryBuilder,\n  type GenericActionCtx,\n  type GenericMutationCtx,\n  type GenericQueryCtx,\n  type GenericDatabaseReader,\n  type GenericDatabaseWriter",{"kind":"504","justification":"360"},{"messageId":"520","data":"521","fix":"522","desc":"523"},{"kind":"504","justification":"360"},[262,446],"FunctionReference,\n  GenericActionCtx,\n  GenericDatabaseReader,\n  GenericDatabaseWriter,\n  GenericMutationCtx,\n  GenericQueryCtx,\n  HttpActionBuilder,\n  MutationBuilder,\n  QueryBuilder",{"kind":"504","justification":"360"},[262,446],{"kind":"504","justification":"360"},[262,446],{"kind":"504","justification":"360"},{"messageId":"520","data":"524","fix":"525","desc":"526"},{"kind":"504","justification":"360"},[471,472],{"kind":"504","justification":"360"},[21,215],{"kind":"504","justification":"360"},[245,394],"componentsGeneric,\n  httpActionGeneric,\n  internalActionGeneric,\n  internalMutationGeneric,\n  internalQueryGeneric,\n  mutationGeneric,\n  queryGeneric",{"kind":"504","justification":"360"},[245,394],{"kind":"504","justification":"360"},[245,394],{"kind":"504","justification":"360"},{"messageId":"520","data":"527","fix":"528","desc":"529"},{"kind":"504","justification":"360"},[1274,1371],"{\n  args: {},\n  handler: async (ctx) => {\n  const data = await ctx.db.query(\"costcoProducts\").collect();\n\n  return data;\n}\n}",{"kind":"504","justification":"360"},[1274,1371],{"kind":"504","justification":"360"},{"messageId":"505","fix":"530","desc":"507"},{"messageId":"508","fix":"531","desc":"510"},{"kind":"504","justification":"360"},{"messageId":"505","fix":"532","desc":"507"},{"messageId":"508","fix":"533","desc":"510"},{"kind":"504","justification":"360"},[254,1410],"brand: v.union(v.string(), v.null()),\n    categories: v.array(v.string()),\n\n    currentInStock: v.boolean(),\n    // Current state (will be updated)\n    currentPrice: v.number(),\n    currentPricePerOunce: v.union(v.number(), v.null()),\n    // Timestamps\n    firstSeen: v.number(),\n    isMemberOnly: v.union(v.boolean(), v.null()),\n    isOnlineOnly: v.union(v.boolean(), v.null()),\n    lastPriceChange: v.union(v.number(), v.null()),\n\n    lastStockChange: v.union(v.number(), v.null()),\n    lastUpdated: v.number(),\n    // Product features\n    marketingFeatures: v.union(v.array(v.string()), v.null()),\n\n    maxQuantity: v.union(v.number(), v.null()),\n    metalPurity: v.union(v.string(), v.null()),\n    // Metal-specific attributes\n    metalType: v.union(v.literal(\"gold\"), v.literal(\"silver\")),\n    metalWeight: v.union(v.string(), v.null()),\n\n    // Product details (relatively static)\n    name: v.string(),\n    productId: v.string(), // Unique product ID from Costco\n    retailerId: v.string(),\n\n    shortDescription: v.union(v.string(), v.null()),\n    thumbnail: v.union(v.string(), v.null()),\n    upc: v.union(v.string(), v.null()),\n    url: v.string()",{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[254,1410],{"kind":"504","justification":"360"},[1657,1800],"price: v.number(),\n    pricePerOunce: v.union(v.number(), v.null()),\n    priceReduced: v.union(v.number(), v.null()),\n    productId: v.string()",{"kind":"504","justification":"360"},[1657,1800],{"kind":"504","justification":"360"},[2072,2119],"inStock: v.boolean(),\n    productId: v.string()",{"kind":"504","justification":"360"},[175,5162],"// Collect Pure spot prices and bids\n  collectPurePrices: defineTable({\n    metalType: v.union(\n      v.literal(\"gold\"),\n      v.literal(\"silver\"),\n      v.literal(\"platinum\"),\n      v.literal(\"palladium\"),\n    ),\n    spotPrice: v.number(), // Current spot price per oz\n    bidPrice: v.number(), // Highest bid price per oz from Collect Pure\n    askPrice: v.union(v.number(), v.null()), // Ask price if available\n    timestamp: v.number(),\n    isMock: v.boolean(), // Flag to identify mock data\n  })\n    .index(\"by_metal\", [\"metalType\"])\n    .index(\"by_timestamp\", [\"timestamp\"])\n    .index(\"by_metal_and_time\", [\"metalType\", \"timestamp\"]),\n\n  // Collect Pure product bids (for specific products matching Costco SKUs)\n  collectPureProductBids: defineTable({\n    productName: v.string(), // Product description (e.g., \"1 oz Gold Bar\")\n    metalType: v.union(v.literal(\"gold\"), v.literal(\"silver\")),\n    weight: v.number(), // Weight in oz\n    purity: v.union(v.string(), v.null()), // e.g., \".9999\"\n    bidPrice: v.number(), // Total bid price for the product\n    bidPricePerOz: v.number(), // Calculated bid per oz\n    timestamp: v.number(),\n    isMock: v.boolean(),\n    // Optional matching to Costco products\n    matchedCostcoProductId: v.union(v.string(), v.null()),\n  })\n    .index(\"by_metal\", [\"metalType\"])\n    .index(\"by_timestamp\", [\"timestamp\"])\n    .index(\"by_matched_product\", [\"matchedCostcoProductId\"]),\n\n  // Main products table - one entry per SKU\n  costcoProducts: defineTable({\n    productId: v.string(), // Unique product ID from Costco\n    retailerId: v.string(),\n\n    // Product details (relatively static)\n    name: v.string(),\n    brand: v.union(v.string(), v.null()),\n    categories: v.array(v.string()),\n    url: v.string(),\n    upc: v.union(v.string(), v.null()),\n    thumbnail: v.union(v.string(), v.null()),\n    shortDescription: v.union(v.string(), v.null()),\n\n    // Metal-specific attributes\n    metalType: v.union(v.literal(\"gold\"), v.literal(\"silver\")),\n    metalWeight: v.union(v.string(), v.null()),\n    metalPurity: v.union(v.string(), v.null()),\n\n    // Product features\n    marketingFeatures: v.union(v.array(v.string()), v.null()),\n    isMemberOnly: v.union(v.boolean(), v.null()),\n    isOnlineOnly: v.union(v.boolean(), v.null()),\n    maxQuantity: v.union(v.number(), v.null()),\n\n    // Current state (will be updated)\n    currentPrice: v.number(),\n    currentPricePerOunce: v.union(v.number(), v.null()),\n    currentInStock: v.boolean(),\n\n    // Timestamps\n    firstSeen: v.number(),\n    lastUpdated: v.number(),\n    lastPriceChange: v.union(v.number(), v.null()),\n    lastStockChange: v.union(v.number(), v.null()),\n  })\n    .index(\"by_product_id\", [\"productId\"])\n    .index(\"by_metal_type\", [\"metalType\"])\n    .index(\"by_metal_and_stock\", [\"metalType\", \"currentInStock\"]),\n\n  // Mapping table to link Costco products to Pure products\n  costcoPureProductMappings: defineTable({\n    costcoProductId: v.string(), // Costco product ID (e.g., \"1957979\")\n    pureSearchCriteria: v.object({\n      material: v.string(), // \"Gold\" or \"Silver\"\n      weight: v.string(), // \"100g\", \"1oz\", \"25g\", etc.\n      manufacturer: v.optional(v.string()), // \"PAMP Suisse\", \"Rand Refinery\", etc.\n      purity: v.optional(v.string()), // \".9999\", \".999\", etc.\n      productType: v.optional(v.string()), // \"bar\", \"coin\", etc.\n      specificSku: v.optional(v.string()), // If we know the exact Pure product ID\n    }),\n    isActive: v.boolean(), // Enable/disable this mapping\n    notes: v.optional(v.string()), // Optional notes about the mapping\n    createdAt: v.number(),\n    updatedAt: v.number(),\n  })\n    .index(\"by_costco_product\", [\"costcoProductId\"])\n    .index(\"by_active\", [\"isActive\"])\n    .index(\"by_material\", [\"pureSearchCriteria.material\"]),\n\n  // Optional: Track fetch runs for debugging/monitoring\n  fetchRuns: defineTable({\n    source: v.union(v.literal(\"costco\"), v.literal(\"collectpure\")),\n    timestamp: v.number(),\n    productsFound: v.number(),\n    productsUpdated: v.number(),\n    priceChanges: v.number(),\n    stockChanges: v.number(),\n    creditsRemaining: v.union(v.number(), v.null()),\n    error: v.union(v.string(), v.null()),\n  })\n    .index(\"by_source\", [\"source\"])\n    .index(\"by_timestamp\", [\"timestamp\"]),\n\n  // Price history table - tracks all price changes\n  priceHistory: defineTable({\n    productId: v.string(),\n    price: v.number(),\n    priceReduced: v.union(v.number(), v.null()),\n    pricePerOunce: v.union(v.number(), v.null()),\n    timestamp: v.number(),\n  })\n    .index(\"by_product_id\", [\"productId\"])\n    .index(\"by_timestamp\", [\"timestamp\"])\n    .index(\"by_product_and_time\", [\"productId\", \"timestamp\"]),\n\n  // Stock history table - tracks stock status changes\n  stockHistory: defineTable({\n    productId: v.string(),\n    inStock: v.boolean(),\n    timestamp: v.number(),\n  })\n    .index(\"by_product_id\", [\"productId\"])\n    .index(\"by_timestamp\", [\"timestamp\"])\n    .index(\"by_product_and_time\", [\"productId\", \"timestamp\"])",{"kind":"504","justification":"360"},[2390,2698],"creditsRemaining: v.union(v.number(), v.null()),\n    error: v.union(v.string(), v.null()),\n    priceChanges: v.number(),\n    productsFound: v.number(),\n    productsUpdated: v.number(),\n    source: v.union(v.literal(\"costco\"), v.literal(\"collectpure\")),\n    stockChanges: v.number(),\n    timestamp: v.number()",{"kind":"504","justification":"360"},[2390,2698],{"kind":"504","justification":"360"},[2390,2698],{"kind":"504","justification":"360"},[175,5162],{"kind":"504","justification":"360"},[2863,3281],"askPrice: v.union(v.number(), v.null()), // Ask price if available\n    bidPrice: v.number(), // Highest bid price per oz from Collect Pure\n    isMock: v.boolean(), // Flag to identify mock data\n    metalType: v.union(\n      v.literal(\"gold\"),\n      v.literal(\"silver\"),\n      v.literal(\"platinum\"),\n      v.literal(\"palladium\"),\n    ),\n    spotPrice: v.number(), // Current spot price per oz\n    timestamp: v.number(),",{"kind":"504","justification":"360"},[2863,3281],{"kind":"504","justification":"360"},[2863,3281],{"kind":"504","justification":"360"},[3549,4056],"bidPrice: v.number(), // Total bid price for the product\n    bidPricePerOz: v.number(), // Calculated bid per oz\n    isMock: v.boolean(),\n    // Optional matching to Costco products\n    matchedCostcoProductId: v.union(v.string(), v.null()),\n    metalType: v.union(v.literal(\"gold\"), v.literal(\"silver\")),\n    productName: v.string(), // Product description (e.g., \"1 oz Gold Bar\")\n    purity: v.union(v.string(), v.null()), // e.g., \".9999\"\n    timestamp: v.number(),\n    weight: v.number(), // Weight in oz",{"kind":"504","justification":"360"},[3549,4056],{"kind":"504","justification":"360"},[3549,4056],{"kind":"504","justification":"360"},[3549,4056],{"kind":"504","justification":"360"},[4421,4816],"manufacturer: v.optional(v.string()), // \"PAMP Suisse\", \"Rand Refinery\", etc.\n      material: v.string(), // \"Gold\" or \"Silver\"\n      productType: v.optional(v.string()), // \"bar\", \"coin\", etc.\n      purity: v.optional(v.string()), // \".9999\", \".999\", etc.\n      specificSku: v.optional(v.string()), // If we know the exact Pure product ID\n      weight: v.string(), // \"100g\", \"1oz\", \"25g\", etc.",{"kind":"504","justification":"360"},[4421,4816],{"kind":"504","justification":"360"},[4384,4979],"createdAt: v.number(),\n    isActive: v.boolean(), // Enable/disable this mapping\n    notes: v.optional(v.string()), // Optional notes about the mapping\n    pureSearchCriteria: v.object({\n      material: v.string(), // \"Gold\" or \"Silver\"\n      weight: v.string(), // \"100g\", \"1oz\", \"25g\", etc.\n      manufacturer: v.optional(v.string()), // \"PAMP Suisse\", \"Rand Refinery\", etc.\n      purity: v.optional(v.string()), // \".9999\", \".999\", etc.\n      productType: v.optional(v.string()), // \"bar\", \"coin\", etc.\n      specificSku: v.optional(v.string()), // If we know the exact Pure product ID\n    })",{"kind":"504","justification":"360"},[4384,4979],{"kind":"504","justification":"360"},{"kind":"504","justification":"360"},"directive","suggestUnknown",{"range":"534","text":"535"},"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct.","suggestNever",{"range":"536","text":"537"},"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of.",{"range":"538","text":"535"},{"range":"539","text":"537"},"replaceEmptyObjectType",{"replacement":"540"},{"range":"541","text":"540"},"Replace `{}` with `object`.",{"replacement":"535"},{"range":"542","text":"535"},"Replace `{}` with `unknown`.","removeUnusedVar",{"varName":"543"},{"range":"544","text":"360"},"Remove unused variable \"AnyComponents\".",{"varName":"545"},{"range":"546","text":"360"},"Remove unused variable \"FunctionReference\".",{"varName":"547"},{"range":"548","text":"360"},"Remove unused variable \"componentsGeneric\".",{"range":"549","text":"535"},{"range":"550","text":"537"},{"range":"551","text":"535"},{"range":"552","text":"537"},[971,974],"unknown",[971,974],"never",[1079,1082],[1079,1082],"object",[1133,1135],[1133,1135],"AnyComponents",[241,258],"FunctionReference",[425,446],"componentsGeneric",[373,394],[14812,14815],[14812,14815],[14998,15001],[14998,15001]]