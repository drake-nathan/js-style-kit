Count":0},{"filePath":"35","messages":"36","suppressedMessages":"37","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/Users/nathandrake/code/js-style-kit/apps/vite-test-app/eslint.config.js",[],[],"/Users/nathandrake/code/js-style-kit/apps/vite-test-app/src/App.tsx",[],["38","39","40"],"/Users/nathandrake/code/js-style-kit/apps/vite-test-app/src/Bar.tsx",[],["41","42","43"],"/Users/nathandrake/code/js-style-kit/apps/vite-test-app/src/main.tsx",[],["44"],"/Users/nathandrake/code/js-style-kit/apps/vite-test-app/src/vite-env.d.ts",[],["45"],"/Users/nathandrake/code/js-style-kit/apps/vite-test-app/vite.config.ts",[],[],"/Users/nathandrake/code/js-style-kit/apps/vite-test-app/src/rule-tests/ReactHooks.tsx",[],["46","47","48","49","50"],{"ruleId":"51","severity":1,"message":"52","line":7,"column":22,"nodeType":"53","messageId":"54","endLine":7,"endColumn":33,"fix":"55","suppressions":"56"},{"ruleId":"57","severity":1,"message":"58","line":17,"column":5,"nodeType":null,"endLine":17,"endColumn":13,"suppressions":"59"},{"ruleId":"60","severity":1,"message":"61","line":34,"column":9,"nodeType":"62","messageId":"63","endLine":40,"endColumn":18,"suppressions":"64"},{"ruleId":"65","severity":1,"message":"66","line":6,"column":14,"nodeType":"67","messageId":"68","endLine":6,"endColumn":17,"suppressions":"69"},{"ruleId":"70","severity":1,"message":"71","line":6,"column":26,"nodeType":"72","messageId":"73","endLine":6,"endColumn":28,"suggestions":"74","suppressions":"75"},{"ruleId":"76","severity":1,"message":"77","line":7,"column":26,"nodeType":"78","messageId":"79","endLine":7,"endColumn":31,"suppressions":"80"},{"ruleId":"81","severity":1,"message":"82","line":9,"column":12,"nodeType":"83","messageId":"84","endLine":9,"endColumn":44,"suppressions":"85"},{"ruleId":"86","severity":2,"message":"87","line":1,"column":1,"nodeType":null,"messageId":"88","suppressions":"89"},{"ruleId":"90","severity":1,"message":"91","line":12,"column":17,"nodeType":"72","endLine":14,"endColumn":4,"suppressions":"92"},{"ruleId":"93","severity":1,"message":"94","line":27,"column":12,"nodeType":null,"endLine":27,"endColumn":21,"suppressions":"95"},{"ruleId":"96","severity":1,"message":"97","line":52,"column":3,"nodeType":null,"endLine":52,"endColumn":10,"suppressions":"98"},{"ruleId":"99","severity":1,"message":"100","line":60,"column":14,"nodeType":null,"endLine":60,"endColumn":27,"suppressions":"101"},{"ruleId":"102","severity":1,"message":"103","line":68,"column":17,"nodeType":null,"endLine":68,"endColumn":28,"suppressions":"104"},"import-x/no-absolute-path","Do not import modules using an absolute path","Literal","absolute",{"range":"105","text":"106"},["107"],"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/nathandrake/code/js-style-kit/apps/vite-test-app/src/App.tsx:17:5\n  15 |     // this proves that the new react-hooks rules work\n  16 |     // eslint-disable-next-line react-hooks/set-state-in-effect\n> 17 |     setCount((count) => count + 1);\n     |     ^^^^^^^^ Avoid calling setState() directly within an effect\n  18 |   }, []);\n  19 |\n  20 |   return (",["108"],"react/button-has-type","Missing an explicit type attribute for button","JSXElement","missingType",["109"],"react-refresh/only-export-components","Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","Identifier","namedExport",["110"],"@typescript-eslint/no-empty-function","Unexpected empty arrow function.","ArrowFunctionExpression","unexpected",["111"],["112"],"react/jsx-no-useless-fragment","Fragments should contain more than one child - otherwise, there’s no need for a Fragment at all.","JSXFragment","NeedsMoreChildren",["113"],"@typescript-eslint/no-non-null-assertion","Forbidden non-null assertion.","TSNonNullExpression","noNonNull",["114"],"unicorn/filename-case","Filename is not in camel case or pascal case. Rename it to `viteEnv.d.ts` or `ViteEnv.d.ts`.","filename-case",["115"],"react/no-unstable-nested-components","Do not define components during render. React will see a new component type on every render and destroy the entire subtree’s DOM nodes and state (https://reactjs.org/docs/reconciliation.html#elements-of-different-types). Instead, move this component definition out of the parent component “ComponentHookFactory” and pass data as props.",["116"],"react-hooks/error-boundaries","Error: Avoid constructing JSX within try/catch\n\nReact does not immediately render components when JSX is rendered, so any errors from this component will not be caught by the try/catch. To catch errors in rendering a given component, wrap that component in an error boundary. (https://react.dev/reference/react/Component#catching-rendering-errors-with-an-error-boundary).\n\n/Users/nathandrake/code/js-style-kit/apps/vite-test-app/src/rule-tests/ReactHooks.tsx:27:12\n  25 |   try {\n  26 |     // eslint-disable-next-line react-hooks/error-boundaries\n> 27 |     return <Child />; // If this throws, catch won't help\n     |            ^^^^^^^^^ Avoid constructing JSX within try/catch\n  28 |   } catch {\n  29 |     return <div>Error occurred</div>;\n  30 |   }",["117"],"react-hooks/set-state-in-render","Error: Calling setState during render may trigger an infinite loop\n\nCalling setState during render will trigger another render, and can lead to infinite loops. (https://react.dev/reference/react/useState).\n\n/Users/nathandrake/code/js-style-kit/apps/vite-test-app/src/rule-tests/ReactHooks.tsx:52:3\n  50 |\n  51 |   // eslint-disable-next-line react-hooks/set-state-in-render\n> 52 |   addItem();\n     |   ^^^^^^^ Found setState() in render\n  53 |\n  54 |   return <div>Items: {items.join(\", \")}</div>;\n  55 | };",["118"],"react-hooks/purity","Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\n/Users/nathandrake/code/js-style-kit/apps/vite-test-app/src/rule-tests/ReactHooks.tsx:60:14\n  58 | export const PurityExample = () => {\n  59 |   // eslint-disable-next-line react-hooks/purity\n> 60 |   const id = Math.random(); // Different every render\n     |              ^^^^^^^^^^^^^ Cannot call impure function\n  61 |   return <div key={id}>Content</div>;\n  62 | };\n  63 |",["119"],"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/nathandrake/code/js-style-kit/apps/vite-test-app/src/rule-tests/ReactHooks.tsx:68:17\n  66 |   const ref = useRef(0);\n  67 |   // eslint-disable-next-line react-hooks/refs\n> 68 |   const value = ref.current; // Don't read during render\n     |                 ^^^^^^^^^^^ Cannot access ref value during render\n  69 |   return <div>{value}</div>;\n  70 | };\n  71 |",["120"],[213,224],"\"../../../../../../../vite.svg\"",{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},{"messageId":"123","data":"124","fix":"125","desc":"126"},{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},{"kind":"121","justification":"122"},"directive","","suggestComment",{"name":"127"},{"range":"128","text":"129"},"Add comment inside empty arrow function.","arrow function",[254,254]," /* empty */ "]